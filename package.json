{
	"name": "squawk",
	"version": "0.1.0",
	"description": "Lets Claude Code sessions on different machines send messages to each other over a local network.",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.12.0",
	"scripts": {
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "tsc -p tsconfig.build.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^24.19.2",
		"@types/ws": "^8.18.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@noble/ciphers": "^2.4.0",
		"@noble/curves": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"bonjour-service": "^1.4.4",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"bin": {
		"squawk": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	]
}
